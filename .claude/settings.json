{
  "permissions": {
    "deny": [
      "Bash(railway variables:*)",
      "Bash(railway variable:*)",
      "Bash(printenv:*)",
      "Bash(env:*)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat backend/.env)",
      "Bash(cat ./backend/.env)",
      "Read(./.env)",
      "Read(./backend/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
